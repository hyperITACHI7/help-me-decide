// Data model for "Help Me Decide" — see ../../phased_architecture.md §3 for the design rationale
// and ../../edge_case.md §2.1 for why Vote is keyed per-item, not per-link.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WishlistVariant {
  small
  large
}

enum TriageDirection {
  keep
  discard
}

enum ShortlistTierName {
  best_pick
  most_trending
  value_for_money
}

model Session {
  id              String          @id @default(cuid())
  createdAt       DateTime        @default(now())
  lastSeenAt      DateTime        @updatedAt
  wishlistVariant WishlistVariant

  items           WishlistItem[]
  triageDecisions TriageDecision[]
  shortlists      Shortlist[]
  shareLinks      ShareLink[]
  categoryPicks   CategoryPicks[]
  analyticsEvents AnalyticsEvent[]
}

// Cache for the wishlist's per-category AI picks, so a category is evaluated
// once rather than on every page view (the shortlist NFR in
// problem_statement.md §3.3, and the Groq key is shared with a sibling
// project).
//
// itemsHash is a hash of the category's current item ids, NOT a counter of
// additions: keying on the actual contents means a DELETION invalidates too,
// which matters because Clean Wishlist can remove an item that is currently
// somebody's "Best pick". Stale rows are simply never read again.
//
// answersHash distinguishes the free automatic picks ("") from picks refined
// by the optional narrowing questions, so both are cached independently.
// Picks are stored as Json rather than FK rows for the same reason: a pick is
// only ever read back through a matching itemsHash, so it cannot outlive the
// items it references.
model CategoryPicks {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  category    String
  itemsHash   String
  answersHash String   @default("")
  questions   Json?
  picks       Json
  createdAt   DateTime @default(now())

  @@unique([sessionId, category, itemsHash, answersHash])
  @@index([sessionId])
}

// No discount/priceDrop/coupon field anywhere in this schema — structural
// enforcement of N1/N5 (see phased_architecture.md §6.3). originalPrice
// exists only to render Myntra's real product-card convention (strikethrough
// price); it is never read by the AI prompts (edge_case.md EC16/EC17 guard
// against exactly that leak).
model WishlistItem {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name            String
  brand           String
  imageUrl        String
  price           Int
  originalPrice   Int?
  rating          Float
  category        String
  tags            String[]
  seededOpenCount Int      @default(0)
  liveOpenCount   Int      @default(0)
  createdAt       DateTime @default(now())

  triageDecisions TriageDecision[]
  shortlistTiers  ShortlistTier[]
  shareLinkItems  ShareLinkItem[]
  votes           Vote[]

  @@index([sessionId])
}

// One row per (session, item) — swiping a card twice upserts this row rather
// than inserting a duplicate (edge_case.md EC9/EC10).
model TriageDecision {
  id        String          @id @default(cuid())
  sessionId String
  session   Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemId    String
  item      WishlistItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  direction TriageDirection
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([sessionId, itemId])
}

// separable = false is reserved for a genuine "too similar to tell apart"
// model judgment. It is NOT used for "fewer than 3 candidates" — that case is
// prevented structurally by the triage floor (edge_case.md §2.2/§2.3), so the
// two states are never conflated.
model Shortlist {
  id               String   @id @default(cuid())
  sessionId        String
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  narrowingAnswers Json
  separable        Boolean
  honestyReason    String?

  tiers     ShortlistTier[]
  shareLink ShareLink?
}

model ShortlistTier {
  id          String            @id @default(cuid())
  shortlistId String
  shortlist   Shortlist         @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  tier        ShortlistTierName
  itemId      String
  item        WishlistItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  reason      String

  @@unique([shortlistId, tier])
  @@unique([shortlistId, itemId])
}

// A share link carries EITHER the AI's shortlist (F6) or a hand-picked
// showcase set the shopper chose from their wishlist. Both are voted on the
// same way; only the source of the item list differs.
model ShareLink {
  id          String     @id @default(cuid())
  shortlistId String?    @unique
  shortlist   Shortlist? @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  // Set for showcase links, so the owner can find their own links back.
  sessionId   String?
  session     Session?   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  token       String     @unique
  createdAt   DateTime   @default(now())
  revokedAt   DateTime?

  items ShareLinkItem[]

  votes Vote[]
}

// The item set behind a showcase link. Absent for shortlist-backed links,
// which resolve their items through Shortlist.tiers instead.
model ShareLinkItem {
  id          String       @id @default(cuid())
  shareLinkId String
  shareLink   ShareLink    @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  itemId      String
  item        WishlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  position    Int          @default(0)

  @@unique([shareLinkId, itemId])
}

// Keyed per (link, voter, item) — resolves edge_case.md §2.1: each of the 3
// shared items gets its own like/dislike swipe from a friend, matching F7's
// "swipe votes" (plural) and mirroring step 3's own triage mechanic.
// voterFingerprint is a random localStorage id, never an identity (R6/N3).
model Vote {
  id               String       @id @default(cuid())
  shareLinkId      String
  shareLink        ShareLink    @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  itemId           String
  item             WishlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  voterFingerprint String
  liked            Boolean
  createdAt        DateTime     @default(now())

  @@unique([shareLinkId, voterFingerprint, itemId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  eventName String
  props     Json?
  createdAt DateTime @default(now())

  @@index([eventName])
  @@index([sessionId])
}
